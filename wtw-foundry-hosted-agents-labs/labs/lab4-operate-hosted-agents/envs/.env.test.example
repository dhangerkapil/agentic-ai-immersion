# Lab 4: per-environment settings for the test environment.
# Shared test project. Redis message store so the two replicas share sessions, sensitive tracing OFF, knowledge base owned by the platform team.
# Copy to WTW-Foundry-Agents-Labs/.env (or let agent-ci.yml do it) and fill the empty values from the GitHub
# Environment "test" variables. Nothing here is a secret: Entra-only auth, no API keys, ever.
# Variable names follow the base repo's .env.example; VIA_ prefixed ones are workshop-specific.

FOUNDRY_PROJECT_ENDPOINT=
PROJECT_RESOURCE_ID=
TENANT_ID=
AZURE_OPENAI_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
FOUNDRY_MODEL=gpt-5.4-mini
EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-large
AZURE_AI_SEARCH_ENDPOINT=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Workshop-specific: the hosted agent reads these as container environment (azd env set)
VIA_TODAY=2026-10-06
VIA_KB_MCP_URL=
VIA_REDIS_URL=<rediss://<name>.<region>.redis.azure.net:10000/0  Azure Managed Redis, Entra auth>
VIA_SESSION_TTL_SECONDS=604800
ENABLE_SENSITIVE_DATA=false
